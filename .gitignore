# ---- OS cruft ----
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
desktop.ini
$RECYCLE.BIN/

# ---- Editors & IDEs ----
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.swp
*.swo
*~

# ---- Node tooling (markdown linting, local scripts) ----
node_modules/
npm-debug.log*
yarn-error.log*
.npm/
package-lock.json

# ---- Local secrets & scratch ----
# Never commit credentials, tokens, or exported configs.
.env
.env.*
!.env.example
*.pem
*.key
*.pfx
*.publishsettings
secrets.json
scratch/
tmp/
*.local
