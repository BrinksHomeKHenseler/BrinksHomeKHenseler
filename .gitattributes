# Normalize line endings so the same file looks identical on Windows and Linux.
* text=auto eol=lf

# Windows-native tooling expects CRLF.
*.ps1   text eol=crlf
*.psm1  text eol=crlf
*.psd1  text eol=crlf
*.bat   text eol=crlf
*.cmd   text eol=crlf

# Explicit text types.
*.md       text diff=markdown
*.yml      text
*.yaml     text
*.json     text
*.jsonc    text
*.sh       text eol=lf

# Binaries — never diff or convert.
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.svg   text
*.ico   binary
*.pdf   binary
*.zip   binary

# Keep repo housekeeping out of GitHub's language stats and release archives.
.github/        export-ignore
.editorconfig   export-ignore
.gitattributes  export-ignore
.gitignore      export-ignore
